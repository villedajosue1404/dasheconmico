# Base de datos (Railway la genera automáticamente al agregar PostgreSQL)
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Entorno
NODE_ENV=production
PORT=3000

# JWT Secret (cambiar en producción)
JWT_SECRET=una-frase-secreta-muy-segura-aqui

# Admin por defecto (primer usuario creado al iniciar DB)
ADMIN_EMAIL=admin@centromando.app
ADMIN_PASSWORD=admin123

# Telegram Userbot — obtener de https://my.telegram.org
TG_API_ID=12345678
TG_API_HASH=abcdef1234567890abcdef1234567890
TG_USER_PHONE=+50212345678
